# 로컬 개발: 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채웁니다.
# Vercel 배포: Project Settings → Environment Variables 에 동일 키를 등록하고 재배포합니다.

ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# 포트폴리오 자료실 — 메타데이터만 Supabase DB에 저장
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# 포트폴리오 자료실 — 파일 본문은 Vercel Blob에 저장
# Vercel Dashboard → Storage → Blob 스토어 연결 시 자동 주입됩니다.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
